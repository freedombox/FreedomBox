#: plinth/modules/avahi/__init__.py:24
#, python-brace-format
msgid ""
"Service discovery allows other devices on the network to discover your "
"{box_name} and services running on it.  It also allows {box_name} to "
"discover other devices and services running on your local network.  Service "
"discovery is not essential and works only on internal networks.  It may be "
"disabled to improve security especially when connecting to a hostile local "
"network."
msgstr ""
"ການຄົ້ນຫາບໍລິການຊ່ວຍໃຫ້ອຸປະກອນອື່ນໆໃນເຄືອຂ່າຍສາມາດຄົ້ນຫາ {box_name} ຂອງທ່ານ ແລະ ບໍລິການທີ່ກຳລັງເ"
"ຮັດວຽກຢູ່. ມັນຍັງຊ່ວຍໃຫ້ {box_name} ສາມາດຄົ້ນຫາອຸປະກອນ ແລະ ບໍລິການອື່ນໆ ໃນເຄືອຂ່າຍທ້ອງຖິ່ນຂອງທ່າ"
"ນ. ການຄົ້ນຫາບໍລິການບໍ່ແມ່ນສິ່ງຈຳເປັນ ແລະ ເຮັດວຽກສະເພາະໃນເຄືອຂ່າຍພາຍໃນເທົ່ານັ້ນ. ມັນອາດຈະຖືກປິດການ"
"ໃຊ້ງານເພື່ອເພີ່ມຄວາມປອດໄພ ໂດຍສະເພາະເມື່ອເຊື່ອມຕໍ່ກັບເຄືອຂ່າຍທ້ອງຖິ່ນທີ່ບໍ່ປອດໄພ."

#: plinth/modules/avahi/__init__.py:47
msgid "Service Discovery"
msgstr "ການຄົ້ນຫາບໍລິການ"

#: plinth/modules/avahi/__init__.py:62
msgid "Local Network Domain"
msgstr "ໂດເມນເຄືອຂ່າຍທ້ອງຖິ່ນ"

#: plinth/modules/avahi/manifest.py:14
msgid "Auto-discovery"
msgstr "ການຄົ້ນຫາອັດຕະໂນມັດ"

#: plinth/modules/avahi/manifest.py:14 plinth/modules/backups/manifest.py:17
msgid "Local"
msgstr "ທ້ອງຖິ່ນ"

#: plinth/modules/avahi/manifest.py:14
msgid "mDNS"
msgstr "mDNS"

#: plinth/modules/backups/__init__.py:27
msgid "Backups allows creating and managing backup archives."
msgstr "ການສຳຮອງຂໍ້ມູນຊ່ວຍໃຫ້ສາມາດສ້າງ ແລະ ຈັດການໄຟລ໌ສຳຮອງໄດ້."

#: plinth/modules/backups/__init__.py:49 plinth/modules/backups/__init__.py:247
#: plinth/modules/backups/__init__.py:292
msgid "Backups"
msgstr "ການສຳຮອງຂໍ້ມູນ"

#: plinth/modules/backups/__init__.py:244
msgid ""
"Enable an automatic backup schedule for data safety. Prefer an encrypted "
"remote backup location or an extra attached disk."
msgstr ""
"ເປີດໃຊ້ການກຳນົດເວລາສຳຮອງຂໍ້ມູນອັດຕະໂນມັດເພື່ອຄວາມປອດໄພຂອງຂໍ້ມູນ. ແນະນຳໃຫ້ໃຊ້ບ່ອນເກັບຂໍ້ມູນທາງໄກທີ່ຖື"
"ກເຂົ້າລະຫັດ ຫຼື ດິສກ໌ເສີມທີ່ເຊື່ອມຕໍ່ໄວ້."

#: plinth/modules/backups/__init__.py:250
msgid "Enable a Backup Schedule"
msgstr "ເປີດໃຊ້ການກຳນົດເວລາສຳຮອງຂໍ້ມູນ"

#: plinth/modules/backups/__init__.py:254
#: plinth/modules/backups/__init__.py:301 plinth/modules/privacy/__init__.py:84
#: plinth/modules/storage/__init__.py:326
#: plinth/modules/upgrades/__init__.py:152
#, python-brace-format
msgid "Go to {app_name}"
msgstr "ໄປທີ່ {app_name}"

#: plinth/modules/backups/__init__.py:289
#, python-brace-format
msgid ""
"A scheduled backup failed. Past {error_count} attempts for backup did not "
"succeed. The latest error is: {error_message}"
msgstr ""
"ການສຳຮອງຂໍ້ມູນຕາມກຳນົດເວລາລົ້ມເຫຼວ. ຄວາມພະຍາຍາມໃນການສຳຮອງຂໍ້ມູນ {error_count} ຄັ້ງທີ່ຜ່ານມາບໍ່"
"ສຳເລັດ. ຂໍ້ຜິດພາດຫຼ້າສຸດແມ່ນ: {error_message}"

#: plinth/modules/backups/__init__.py:297
msgid "Error During Backup"
msgstr "ເກີດຂໍ້ຜິດພາດລະຫວ່າງການສຳຮອງຂໍ້ມູນ"

#: plinth/modules/backups/forms.py:34
#, python-brace-format
msgid "{app} (No data to backup)"
msgstr "{app} (ບໍ່ມີຂໍ້ມູນທີ່ຈະສຳຮອງ)"

#: plinth/modules/backups/forms.py:54
msgid "Enable scheduled backups"
msgstr "ເປີດໃຊ້ການສຳຮອງຂໍ້ມູນຕາມກຳນົດເວລາ"

#: plinth/modules/backups/forms.py:55
msgid ""
"If enabled, a backup is taken every day, every week and every month. Older "
"backups are removed."
msgstr ""
"ຫາກເປີດໃຊ້ງານ, ການສຳຮອງຂໍ້ມູນຈະຖືກເຮັດທຸກມື້, ທຸກອາທິດ ແລະ ທຸກເດືອນ. ຂໍ້ມູນສຳຮອງທີ່ເກົ່າກວ່າຈະຖືກລຶບອ"
"ອກ."

#: plinth/modules/backups/forms.py:59
msgid "Number of daily backups to keep"
msgstr "ຈຳນວນຂໍ້ມູນສຳຮອງລາຍວັນທີ່ຈະເກັບໄວ້"

#: plinth/modules/backups/forms.py:60
msgid ""
"This many latest backups are kept and the rest are removed. A value of \"0\" "
"disables backups of this type. Triggered at specified hour every day."
msgstr ""
"ຈຳນວນຂໍ້ມູນສຳຮອງຫຼ້າສຸດທີ່ຈະຖືກເກັບໄວ້ ແລະ ສ່ວນທີ່ເຫຼືອຈະຖືກລຶບອອກ. ຫາກກຳນົດເປັນ \"0\" ຈະປິດການສຳຮ"
"ອງຂໍ້ມູນປະເພດນີ້. ຈະເລີ່ມເຮັດວຽກຕາມຊົ່ວໂມງທີ່ກຳນົດໄວ້ໃນທຸກໆມື້."

#: plinth/modules/backups/forms.py:65
msgid "Number of weekly backups to keep"
msgstr "ຈຳນວນຂໍ້ມູນສຳຮອງລາຍອາທິດທີ່ຈະເກັບໄວ້"

#: plinth/modules/backups/forms.py:67
msgid ""
"This many latest backups are kept and the rest are removed. A value of \"0\" "
"disables backups of this type. Triggered at specified hour every Sunday."
msgstr ""
"ຈຳນວນຂໍ້ມູນສຳຮອງຫຼ້າສຸດທີ່ຈະຖືກເກັບໄວ້ ແລະ ສ່ວນທີ່ເຫຼືອຈະຖືກລຶບອອກ. ຫາກກຳນົດເປັນ \"0\" ຈະປິດການສຳຮ"
"ອງຂໍ້ມູນປະເພດນີ້. ຈະເລີ່ມເຮັດວຽກຕາມຊົ່ວໂມງທີ່ກຳນົດໄວ້ໃນທຸກໆວັນອາທິດ."

#: plinth/modules/backups/forms.py:72
msgid "Number of monthly backups to keep"
msgstr "ຈຳນວນຂໍ້ມູນສຳຮອງລາຍເດືອນທີ່ຈະເກັບໄວ້"

#: plinth/modules/backups/forms.py:74
msgid ""
"This many latest backups are kept and the rest are removed. A value of \"0\" "
"disables backups of this type. Triggered at specified hour first day of "
"every month."
msgstr ""
"ຈຳນວນຂໍ້ມູນສຳຮອງຫຼ້າສຸດທີ່ຈະຖືກເກັບໄວ້ ແລະ ສ່ວນທີ່ເຫຼືອຈະຖືກລຶບອອກ. ຫາກກຳນົດເປັນ \"0\" ຈະປິດການສຳຮ"
"ອງຂໍ້ມູນປະເພດນີ້. ຈະເລີ່ມເຮັດວຽກຕາມຊົ່ວໂມງທີ່ກຳນົດໄວ້ໃນມື້ທຳອິດຂອງທຸກໆເດືອນ."

#: plinth/modules/backups/forms.py:79
msgid "Hour of the day to trigger backup operation"
msgstr "ຊົ່ວໂມງຂອງມື້ທີ່ຈະເລີ່ມການສຳຮອງຂໍ້ມູນ"

#: plinth/modules/backups/forms.py:81
msgid ""
"In 24 hour format. Services may become temporarily unavailable while running "
"backup operation at this time of the day."
msgstr ""
"ໃນຮູບແບບ 24 ຊົ່ວໂມງ. ບໍລິການຕ່າງໆອາດຈະບໍ່ສາມາດໃຊ້ງານໄດ້ຊົ່ວຄາວໃນຂະນະທີ່ກຳລັງສຳຮອງຂໍ້ມູນໃນເວລານີ້."

