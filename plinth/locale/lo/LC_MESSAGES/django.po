#: plinth/templates/port-forwarding-info.html:9
msgid "Port Forwarding"
msgstr "ການສົ່ງຕໍ່ພອດ (Port Forwarding)"

#: plinth/templates/port-forwarding-info.html:14
#, python-format
msgid ""
"Your FreedomBox is <a href=\"%(networks_url)s\">not behind a router</a>. No "
"action is necessary."
msgstr ""
"FreedomBox ຂອງທ່ານ <a href=\"%(networks_url)s\">ບໍ່ໄດ້ຢູ່ຫຼັງເລົາເຕີ (router)</a>. ບໍ່ຈຳເ"
"ປັນຕ້ອງຕັ້ງຄ່າໃດໆ."

#: plinth/templates/port-forwarding-info.html:22
#, python-format
msgid ""
"Your FreedomBox is <a href=\"%(networks_url)s\"> behind a router</a> and you "
"are using the DMZ feature to forward all ports. No further router "
"configuration is necessary."
msgstr ""
"FreedomBox ຂອງທ່ານ <a href=\"%(networks_url)s\">ຢູ່ຫຼັງເລົາເຕີ</a> ແລະ ທ່ານກຳລັງໃຊ້ "
"DMZ ເພື່ອສົ່ງຕໍ່ທຸກພອດ. ບໍ່ຈຳເປັນຕ້ອງຕັ້ງຄ່າເລົາເຕີເພີ່ມເຕີມ."

#: plinth/templates/port-forwarding-info.html:31
#, python-format
msgid ""
"Your FreedomBox is <a href=\"%(networks_url)s\">behind a router</a> and you "
"are not using the DMZ feature. You will need to set up port forwarding on "
"your router. You should forward the following ports for %(service_name)s:"
msgstr ""
"FreedomBox ຂອງທ່ານ <a href=\"%(networks_url)s\">ຢູ່ຫຼັງເລົາເຕີ</a> ແລະ ບໍ່ໄດ້ໃຊ້ DMZ. ທ່າ"
"ນຈຳເປັນຕ້ອງຕັ້ງຄ່າ port forwarding ໃນເລົາເຕີຂອງທ່ານ ໂດຍສົ່ງຕໍ່ພອດຕໍ່ໄປນີ້ ສຳລັບ %"
"(service_name)s:"

#: plinth/templates/port-forwarding-info.html:43
msgid "Service Name"
msgstr "ຊື່ບໍລິການ"

#: plinth/templates/port-forwarding-info.html:44
msgid "Protocol"
msgstr "ໂປຣໂຕຄໍ"

#: plinth/templates/port-forwarding-info.html:45
msgid "From Router/WAN Ports"
msgstr "ຈາກພອດ Router/WAN"

#: plinth/templates/port-forwarding-info.html:46
#, python-format
msgid "To %(box_name)s Ports"
msgstr "ໄປຍັງພອດຂອງ %(box_name)s"

